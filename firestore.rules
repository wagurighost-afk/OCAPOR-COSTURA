rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isAuthenticated() && getUserData().active == true;
    }

    function isAdmin() {
      return isActiveUser() && getUserData().role == 'ADMIN';
    }

    function isCostura() {
      return isActiveUser() && getUserData().role == 'COSTURA';
    }

    match /users/{userId} {
      allow read: if isActiveUser() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /productionOrders/{orderId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if false;
    }

    match /repairs/{repairId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if false;
    }

    match /releases/{releaseId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if false;
    }
  }
}
