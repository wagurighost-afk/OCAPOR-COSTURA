rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isAuthenticated() && getUserData().active == true;
    }

    function isAdmin() {
      return isActiveUser() && getUserData().role == 'ADMIN';
    }

    function isCosturaGestao() {
      return isActiveUser() && getUserData().role == 'COSTURA_GESTAO';
    }

    function isCosturaOperacional() {
      return isActiveUser() && getUserData().role == 'COSTURA_OPERACIONAL';
    }

    function isCostura() {
      return isActiveUser() && (
        getUserData().role == 'COSTURA_GESTAO' ||
        getUserData().role == 'COSTURA_OPERACIONAL'
      );
    }

    function canManageCosturaOperations() {
      return isAdmin() || isCosturaGestao() || isCosturaOperacional();
    }

    match /users/{userId} {
      allow read: if isActiveUser() && (request.auth.uid == userId || isAdmin() || isCosturaGestao());
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin() || isCosturaGestao();
    }

    match /products/{productId} {
      allow read: if isActiveUser();
      allow create, update: if canManageCosturaOperations();
      allow delete: if false;
    }

    match /requests/{requestId} {
      allow read: if isActiveUser();
      allow create, update: if canManageCosturaOperations();
      allow delete: if false;
    }

    match /productionOrders/{orderId} {
      allow read: if isActiveUser();
      allow create, update: if canManageCosturaOperations();
      allow delete: if false;
    }

    match /repairs/{repairId} {
      allow read: if isActiveUser();
      allow create, update: if canManageCosturaOperations();
      allow delete: if false;
    }

    match /releases/{releaseId} {
      allow read: if isActiveUser();
      allow create: if canManageCosturaOperations();
      allow update, delete: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if isActiveUser();
      allow create: if canManageCosturaOperations();
      allow update, delete: if false;
    }
  }
}
